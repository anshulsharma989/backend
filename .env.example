# Copy to .env and adjust as needed.

# --- Database ---
DATABASE_URL=postgresql+psycopg://educator:educator@localhost:5432/educator

# --- Embeddings ---
# Provider: "sentence_transformers" (local, default) or "ollama"
EMBEDDING_PROVIDER=sentence_transformers
# bge-m3 is multilingual (English + Hindi, cross-lingual). 1024 dims.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- LLM ---
# Provider: "ollama" (local, default) or "claude"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b has strong Hindi. Use qwen2.5:3b on low-RAM machines.
OLLAMA_MODEL=qwen2.5:7b

# Only needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Ingestion ---
CHUNK_SIZE_CHARS=3200
CHUNK_OVERLAP_CHARS=400
UPLOAD_DIR=./data/uploads

# --- Retrieval ---
TOP_K=6
