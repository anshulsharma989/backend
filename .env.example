# Copy to .env and adjust as needed.

# --- Database ---
DATABASE_URL=postgresql+psycopg://educator:educator@localhost:5432/educator

# --- Embeddings ---
# Provider: "sentence_transformers" (local, default) or "ollama"
EMBEDDING_PROVIDER=sentence_transformers
# bge-m3 is multilingual (English + Hindi, cross-lingual). 1024 dims.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Set to true only after EMBEDDING_MODEL has been downloaded once — skips the
# Hugging Face Hub freshness check and loads straight from the local cache.
HF_HUB_OFFLINE=false

# --- LLM ---
# Provider: "ollama" (local, default) or "claude"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b has strong Hindi. Use qwen2.5:3b on low-RAM machines.
OLLAMA_MODEL=qwen2.5:7b

# Only needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Ingestion ---
CHUNK_SIZE_CHARS=3200
CHUNK_OVERLAP_CHARS=400
UPLOAD_DIR=./data/uploads

# --- Retrieval ---
TOP_K=6

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173

# --- Dev seed accounts (optional; read only by `python -m app.cli seed`) ---
# Leave unset to skip — use `create-admin` and real signups instead.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_NAME=Admin
# SEED_STUDENT_EMAIL=student@example.com
# SEED_STUDENT_PASSWORD=change-me
# SEED_STUDENT_NAME=Student
# SEED_STUDENT_GRADE=Grade 9
